NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 瞬録(GPS)チェックイン時の周辺店舗候補取得用(Google Places API (New))。
# 未設定でも動作は継続する(候補が出ず手入力のみになる)。
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# 「ちかく」画面の地図表示用(Google Maps JavaScript API)。未設定時は
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEYを流用する(同じキーでMaps JavaScript APIも
# 有効化していれば追加設定は不要)。どちらも未設定の場合は地図非表示・一覧表示のみになる。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 終電・帰宅アラート(画面④)のラベルと終電目安時刻。個人の生活圏に依存するため
# 未設定時は「自宅」「職場」という汎用ラベルにフォールバックする。
NEXT_PUBLIC_COMMUTE_HOME_LABEL=
NEXT_PUBLIC_COMMUTE_HOME_LAST_TRAIN=
NEXT_PUBLIC_COMMUTE_WORK_LABEL=
NEXT_PUBLIC_COMMUTE_WORK_LAST_TRAIN=
